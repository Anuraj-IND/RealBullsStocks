# Reference of every environment variable used across the stack.
#
# Runtime reads per-app files, NOT this one:
#   apps/api/.env        <- copy apps/api/.env.example
#   apps/web/.env.local  <- copy apps/web/.env.example
#   infra/.env           <- copy infra/.env.example (Docker Compose / production)
#
# The Go gateway reads variables from the process environment
# (export them, or use the values below when running `go run ./cmd/gateway`).

# --- Core ---
NODE_ENV=development
API_PORT=4000
WS_PORT=8080
# Root domain used for whitelabel tenant resolution (subdomain routing)
ROOT_DOMAIN=realbulls.local

# --- Database / cache ---
DATABASE_URL=postgresql://realbulls:realbulls@localhost:5432/realbulls?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (rotate before any real deployment) ---
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- API ---
PNL_TICK_MS=1000
REGISTRY_KEY=realbulls:registry
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
ALLOW_SIGNUP=true
SIGNUP_STARTING_BALANCE=100000

# --- Web (NEXT_PUBLIC_* are baked into the client bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=realbulls.local
API_INTERNAL_URL=http://localhost:4000
ALLOWED_DEV_ORIGINS=

# --- WS gateway ---
# Comma separated crypto symbols mirrored from Binance public WS
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt

# --- Optional providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT=http://localhost:4000/broker/zerodha/callback
TWELVEDATA_API_KEY=
