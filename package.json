{
  "name": "realbulls",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,go,md,json}\"",
    "db:generate": "pnpm --filter @realbulls/db generate",
    "db:migrate": "pnpm --filter @realbulls/db migrate",
    "db:push": "pnpm --filter @realbulls/db push",
    "db:seed": "pnpm --filter @realbulls/db seed",
    "db:reset-admin": "pnpm --filter @realbulls/db reset-admin",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
