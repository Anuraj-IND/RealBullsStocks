# Copy to infra/.env before running Docker Compose / deploying.
# Never commit this file. It is consumed by infra/docker-compose.yml.
#
# Generate secrets:
#   openssl rand -hex 32   # JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
#   openssl rand -hex 24   # POSTGRES_PASSWORD (avoid @ : / ? # in the URL)

# --- Public host(s) ---
# Primary hostname Caddy serves. DNS must point at the server.
PUBLIC_HOST=app.example.com
# Space separated hostnames Caddy issues certificates for.
# Only include www if you created a DNS record for it.
SITES=app.example.com
# Caddy site addresses are space-separated:
# SITES=app.example.com www.app.example.com
# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=https://app.example.com
# CORS_ORIGINS=https://app.example.com,https://www.app.example.com
# Tenant root for whitelabel subdomains. For a single host this equals PUBLIC_HOST.
ROOT_DOMAIN=app.example.com

# --- Caddy / TLS ---
ACME_EMAIL=admin@example.com

# --- Secrets (must change in production) ---
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
POSTGRES_PASSWORD=change-me-use-a-long-random-value

# --- Redis ---
REGISTRY_KEY=realbulls:registry

# --- Feed symbols ---
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt

# --- Optional providers ---
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOLS=EURUSD=EUR/USD,GBPUSD=GBP/USD,USDJPY=USD/JPY,AUDUSD=AUD/USD,XAUUSD=XAU/USD
# 15s: one batched request per poll stays inside TwelveData's free-plan limits.
TWELVEDATA_POLL_MS=15000
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_SYMBOLS=
# Aligned with the API quote-bridge (QUOTE_BRIDGE_POLL_MS=2000).
ZERODHA_POLL_MS=2000
# Must match the Kite Connect app redirect URL.
ZERODHA_REDIRECT=https://app.example.com/api/broker/zerodha/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Signup ---
ALLOW_SIGNUP=false
SIGNUP_STARTING_BALANCE=100000
