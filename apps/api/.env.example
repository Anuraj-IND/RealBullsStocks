# Copy to apps/api/.env and fill in. This file is committed; never put real secrets here.

# --- Core ---
NODE_ENV=development
API_PORT=4000
# Root domain used for whitelabel tenant resolution (subdomain routing)
ROOT_DOMAIN=realbulls.local

# --- Database / cache ---
DATABASE_URL=postgresql://realbulls:realbulls@localhost:5432/realbulls?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (rotate before any real deployment) ---
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Background jobs ---
PNL_TICK_MS=1000
# Redis key the API publishes the instrument registry on (read by the Go gateway)
REGISTRY_KEY=realbulls:registry

# --- CORS / public URLs ---
# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Absolute base used in OAuth redirects and broker callbacks
PUBLIC_API_BASE=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# --- Signup ---
ALLOW_SIGNUP=true
SIGNUP_STARTING_BALANCE=100000

# --- OAuth providers (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Zerodha Kite Connect (optional, live NSE/BSE quotes) ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT=http://localhost:4000/broker/zerodha/callback
