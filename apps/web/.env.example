# Copy to apps/web/.env.local and fill in. NEXT_PUBLIC_* values are baked into the
# client bundle at build time, so rebuild after changing them.

# --- Public endpoints (browser-facing) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=realbulls.local

# --- Server-side ---
# Used by the Next.js server to reach the API (Docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
ROOT_DOMAIN=realbulls.local

# --- Dev only ---
# Extra origins allowed to reach the Next dev server (e.g. localhost tunnel hosts).
ALLOWED_DEV_ORIGINS=
# Display conversion rate for market-terms prices (must match the API's USD_INR).
NEXT_PUBLIC_USD_INR=83.5
